---
import { useTranslations, type Lang } from "@i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang);
const targetLang: Lang = lang === "es" ? "en" : "es";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Preserva la página actual al cambiar de idioma (no todo es la SPA de un
// solo path — páginas como /aws-certification también existen en /en).
let path = Astro.url.pathname;
if (path.startsWith(base)) path = path.slice(base.length);
if (!path.startsWith("/")) path = `/${path}`;
path = path.replace(/\/$/, "") || "/";
if (path === "/en" || path.startsWith("/en/")) path = path.slice(3) || "/";

const targetHref = targetLang === "es" ? `${base}${path}` : `${base}/en${path === "/" ? "" : path}`;
---

<a
  id="lang-toggle"
  href={targetHref}
  aria-label={t("lang.switch")}
  class="flex h-11 items-center justify-center rounded-full border border-nebula-violet/30 bg-surface/50 px-4 font-mono text-xs uppercase tracking-widest text-ink-secondary backdrop-blur-md transition-all duration-300 hover:border-nebula-cyan/60 hover:text-ink-primary focus-visible:outline-nebula-cyan"
>
  {targetLang}
</a>

<script define:vars={{ targetLang, base }}>
  // El href de arriba se calcula en el servidor con la URL de la petición
  // inicial. Pero en la SPA principal, abrir un panel (p. ej. Certificaciones)
  // no navega — solo cambia el "?open=" de la URL en el cliente (ver
  // MainScreen.tsx). Por eso, al hacer clic, recalculamos el destino con la
  // URL actual del navegador para no perder el panel abierto.
  (function () {
    var link = document.getElementById("lang-toggle");
    if (!link) return;
    link.addEventListener("click", function (event) {
      event.preventDefault();
      var path = window.location.pathname;
      if (path.indexOf(base) === 0) path = path.slice(base.length);
      if (path.indexOf("/") !== 0) path = "/" + path;
      path = path.replace(/\/$/, "") || "/";
      if (path === "/en" || path.indexOf("/en/") === 0) path = path.slice(3) || "/";

      var target = targetLang === "es" ? base + path : base + "/en" + (path === "/" ? "" : path);
      window.location.href = target + window.location.search;
    });
  })();
</script>
