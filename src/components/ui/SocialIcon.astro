---
interface Props {
  icon: string;
  class?: string;
}

const { icon, class: className = "h-4 w-4" } = Astro.props as Props;
---

{icon === "github" && (
  <svg viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true">
