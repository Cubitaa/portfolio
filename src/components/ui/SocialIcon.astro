  </svg>
)}
{icon === "linkedin" && (
  <svg viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true">
    <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.15 1.45-2.15 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.35-1.85 3.59 0 4.25 2.36 4.25 5.43v6.31ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z" />
  </svg>
)}
{icon === "twitter" && (
  <svg viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true">
    <path d="M18.9 2.5h3.4l-7.4 8.46 8.7 10.54h-6.82l-5.34-6.6-6.11 6.6H1.4l7.92-9.05L1 2.5h6.99l4.83 6.03L18.9 2.5Zm-1.2 17.02h1.88L7.4 4.37H5.38l12.32 15.15Z" />
  </svg>
)}
{icon === "mail" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class={className} aria-hidden="true">
    <rect x="2.5" y="4.5" width="19" height="15" rx="2" />
    <path d="m3 6 9 7 9-7" />
  </svg>
)}
{!["github", "linkedin", "twitter", "mail"].includes(icon) && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class={className} aria-hidden="true">
    <circle cx="12" cy="12" r="9" />
  </svg>
)}
