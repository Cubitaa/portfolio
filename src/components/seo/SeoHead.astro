---
import { getEntry } from "astro:content";
import type { Lang } from "@i18n/utils";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  ogImage?: string;
}

const { lang, title, description, ogImage } = Astro.props as Props;

const seoEntry = await getEntry("seo", "seo");
const seo = seoEntry!.data;
const heroEntry = await getEntry("hero", "hero");
const hero = heroEntry!.data.content[lang];
const socialsEntry = await getEntry("socials", "socials");
const socials = socialsEntry!.data.items;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const image = new URL(ogImage ?? seo.defaultOgImage, Astro.site).toString();

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: hero.name,
  jobTitle: hero.role,
  url: canonicalUrl,
  sameAs: socials.filter((s) => !s.url.startsWith("mailto:")).map((s) => s.url),
};
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={canonicalUrl} />

<link rel="alternate" hreflang="es" href={new URL(`${base}/`, Astro.site).toString()} />
<link rel="alternate" hreflang="en" href={new URL(`${base}/en`, Astro.site).toString()} />
<link rel="alternate" hreflang="x-default" href={new URL(`${base}/`, Astro.site).toString()} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={seo.siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={image} />
<meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
{seo.twitterHandle && <meta name="twitter:site" content={seo.twitterHandle} />}

<!-- Favicons / PWA -->
<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
<link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png`} />
<link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16x16.png`} />
<link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
<link rel="manifest" href={`${base}/site.webmanifest`} />
<meta name="theme-color" content={seo.themeColorDark} />

<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
