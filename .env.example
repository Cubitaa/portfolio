# Copia este archivo a .env y rellena tus valores.
# Consigue tu access key gratis en https://web3forms.com (solo con tu email,
# sin verificar cada formulario). Es una clave pública: se incrusta en el
# bundle del cliente a propósito, Web3Forms está diseñado para eso.

PUBLIC_WEB3FORMS_ACCESS_KEY=tu-access-key
